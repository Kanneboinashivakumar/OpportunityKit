# ==============================================================================
# OpportunityKit .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Next.js & Turbopack build outputs
/.next/
/out/
/build
/dist
.turbo

# Environment files & Secrets
# NEVER commit .env files containing real keys or credentials
.env
.env*.local
.env.production
.env.staging
!.env.example
*.pem
*.key
*.cert
*.crt

# Debug & Execution Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
/coverage
*.lcov

# OS & System artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# TypeScript build info & Next.js generated types
*.tsbuildinfo
next-env.d.ts

# Private user data, local uploads, resumes & database dumps
/uploads
/temp
/tmp
*.pdf
*.docx
*.dump
*.sql.dump
dump.sql
*.backup
*.tar.gz
