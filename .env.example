# ==============================================================================
# OpportunityKit Environment Variables Template
# Copy this file to .env.local and populate with your own credentials.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Backend administrative scripts only)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini AI Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extraction & Rate Limiting Controls
MAX_ANNOUNCEMENT_CHARS=30000
EXTRACTION_RATE_LIMIT_PER_HOUR=20
